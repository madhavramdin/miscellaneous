host *
   ControlMaster auto
   ControlPersist 10m
   ControlPath ~/.ssh/cm/%C
   Compression no
   ServerAliveInterval 30
   ServerAliveCountMax 3
   SetEnv TERM=xterm
   StrictHostKeyChecking no
   IdentityFile ~/.ssh/id_ed25519
   IdentitiesOnly yes
   User mramdin
# Bitbucket (Work)
Host bitbucket.org
  HostName bitbucket.org
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# GitHub (Personal)
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/github
  IdentitiesOnly yes
Host 10.1.50.*
   HostKeyAlgorithms +ssh-rsa
   PubkeyAcceptedAlgorithms +ssh-rsa
Host 10.1.187.*
   ProxyJump 10.1.90.19
Host 10.1.188.*
